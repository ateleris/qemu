{"api": 1, "name": "gate-timesync",
 "description": "TC(9,129) in obt mode (D-PLd). aligned: the default epoch; after the sync the controller's exact-time verdict is ok and the next heartbeat's CUC equals the OBT. mismatch: obt_epoch & 63 = 32, so the codes' TIMECNT disagrees with the FSW time: no 0x1429 and a CUC far from the OBT before the TC(9,129), exact after it. The automatic sync is off here so the state before it can be seen.",
 "duration_s": 80,
 "variants": ["aligned", "mismatch"],
 "config": {"timesync": {"autostart": "off"}},
 "variant_config": {"mismatch": {"qemu": {"obt_epoch": 17592188141568}}},
 "setup": [{"do": "platform.power.on"}],
 "steps": [
  {"at": 0, "name": "boot", "do": "platform.power.boot",
   "await_event": [{"eid": "14a3", "timeout_s": 50}],
   "assert_no_tm": ["0x5A1:1:8"]},
  {"at": 0, "name": "mismatch: no resync by the codes",
   "variants": ["mismatch"],
   "assert_no_event": [{"eid": "1429", "for_s": 58}]},
  {"at": 55, "name": "mismatch: the CUC is far from the OBT",
   "variants": ["mismatch"],
   "expect_cuc": [{"apid": "0x5E5", "outside_s": 10, "timeout_s": 4}]},
  {"at": 60, "name": "TC(9,129)", "do": "platform.timesync.send",
   "await_tm": [{"tm": "0x5A1:1:7:1dac", "timeout_s": 3}],
   "await_state": [{"path": "platform.timesync.verdict", "eq": "ok",
                    "timeout_s": 10}]},
  {"at": 66, "name": "the CUC equals the OBT",
   "expect_cuc": [{"apid": "0x5E5", "within_s": 0.3, "timeout_s": 4}]}],
 "teardown": [{"do": "platform.power.off"}]}
