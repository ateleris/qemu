{"api": 1, "name": "gate-spw-link",
 "description": "SpW link outage, derived from the fault-smoke link-down rows (fault-smoke.sh stays the canonical C gate). Unlike fault-smoke, the platform keep-alive runs (125 ms), so no boot-armed 0x142E is expected in any variant. fault_no_recovery: SPW_send refuses while LS != RUN (SPW.c:692-696), so after the injection no TM leaves at all and the queued 0x5435 never does. fault_with_recovery: the clear at +80 releases the queued 0x5435 48 and gives 0x142D 00 within 10 s.",
 "duration_s": 100,
 "variants": ["nominal", "fault_no_recovery", "fault_with_recovery"],
 "setup": [{"do": "platform.power.on"}],
 "steps": [
  {"at": 0, "name": "boot", "do": "platform.power.boot",
   "await_event": [{"eid": "14a3", "timeout_s": 50}],
   "await_state": [{"path": "platform.timesync.verdict", "eq": "ok",
                    "timeout_s": 50}],
   "assert_no_tm": ["0x5A1:1:2", "0x5A1:1:8"]},
  {"at": 0, "name": "nominal: no link events", "variants": ["nominal"],
   "assert_no_event": [{"eid": "5435"}, {"eid": "142d"}, {"eid": "142e"}]},
  {"at": 60, "name": "link down", "variants": ["fault_*"],
   "do": "fault.inject", "args": {"id": "spw.link.disconnect"},
   "await_state": [{"path": "platform.spw.link", "eq": "down",
                    "timeout_s": 2},
                   {"path": "platform.keepalive.suppressed",
                    "changed": true, "timeout_s": 5}],
   "assert_silence": {"after_s": 2, "for_s": 15}},
  {"at": 60, "name": "no recovery: silent to the end",
   "variants": ["fault_no_recovery"],
   "assert_silence": {"after_s": 17, "for_s": 21},
   "assert_no_event": [{"eid": "5435"}, {"eid": "142d"}]},
  {"at": 60, "name": "recovery: the queued 0x5435",
   "variants": ["fault_with_recovery"],
   "await_event": [{"eid": "5435", "data": "48", "timeout_s": 35}],
   "assert_no_event": [{"eid": "142e"}]},
  {"at": 80, "name": "link up", "variants": ["fault_with_recovery"],
   "do": "fault.clear", "args": {"id": "spw.link.disconnect"},
   "await_event": [{"eid": "142d", "data": "00", "timeout_s": 10}]}],
 "teardown": [{"do": "platform.power.off"}]}
