{"api": 1, "name": "gate-fault-reapply",
 "description": "The cold-cycle re-apply of the device-state faults (PL-11a, the flash plan's O2): attenuator.current.offset is a qom fault on /machine/stixctrl/attenuator whose property a cold power cycle loses (a new QEMU process), so the platform must re-apply it before cont. fault_reapply: the inject moves instrument.hk_adc.8 (ATT_C, idle 20) presented to 820, a power.cycle brings the clean device back and the re-applied fault must move the leaf again; the clear then restores the pre-fault value (the prior captured at the first apply, kept across the cycle). nominal: the same cycle with no fault leaves the leaf clean. The 500/100 bounds leave room for the idle truth and the 800 offset.",
 "duration_s": 130,
 "variants": ["nominal", "fault_reapply"],
 "setup": [{"do": "platform.power.on"}],
 "steps": [
  {"at": 0, "name": "boot", "do": "platform.power.boot",
   "await_event": [{"eid": "14a3", "timeout_s": 50}],
   "await_state": [{"path": "instrument.hk_adc.8", "layer": "presented",
                    "lt": 100, "timeout_s": 50}]},
  {"at": 10, "name": "inject the ATT_C offset",
   "variants": ["fault_reapply"],
   "do": "fault.inject",
   "args": {"id": "attenuator.current.offset", "params": {"offset": 800}},
   "await_state": [{"path": "instrument.hk_adc.8", "layer": "presented",
                    "gt": 500, "timeout_s": 10}]},
  {"at": 20, "name": "cold cycle: the fault comes back",
   "variants": ["fault_reapply"],
   "do": "platform.power.cycle", "args": {"boot": true},
   "await_state": [{"path": "instrument.hk_adc.8", "layer": "presented",
                    "gt": 500, "timeout_s": 60}]},
  {"at": 20, "name": "cold cycle: no fault, the leaf stays clean",
   "variants": ["nominal"],
   "do": "platform.power.cycle", "args": {"boot": true},
   "await_state": [{"path": "instrument.hk_adc.8", "layer": "presented",
                    "lt": 100, "timeout_s": 60}]},
  {"at": 80, "name": "clear restores the pre-fault value",
   "variants": ["fault_reapply"],
   "do": "fault.clear", "args": {"id": "attenuator.current.offset"},
   "await_state": [{"path": "instrument.hk_adc.8", "layer": "presented",
                    "lt": 100, "timeout_s": 20}]}],
 "teardown": [{"do": "platform.power.off"}]}
