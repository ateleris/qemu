    {"id": "attenuator.current.zero", "class": "signal",
     "changes": "presented",
     "target": "instrument.hk_adc.8", "mode": "zero",
     "params": {},
     "persistence": "until_cleared", "reversible": true,
     "action": {"kind": "qom", "path": "/machine/stixctrl/attenuator",
                "property": "attenuator.current.zero", "value": true},
     "preconditions": [
       "visible on AX too; no TM (255-sample persistence, the plan's outcome table)"],
     "expected_detection": []},
    {"id": "attenuator.current.offset", "class": "signal",
     "changes": "presented",
     "target": "instrument.hk_adc.8", "mode": "offset",
     "params": {"offset": {"type": "integer", "min": -4095, "max": 4095,
                           "default": 0, "unit": "adc",
                           "index_space": "ch"}},
     "persistence": "until_cleared", "reversible": true,
     "action": {"kind": "qom", "path": "/machine/stixctrl/attenuator",
                "property": "attenuator.current.offset",
