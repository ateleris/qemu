    {"id": "attenuator.mechanism.jammed", "class": "component",
     "changes": "truth",
     "target": "instrument.attenuator.mechanism", "mode": "jammed",
     "params": {},
     "persistence": "until_cleared", "reversible": true,
     "action": {"kind": "qom", "path": "/machine/stixctrl/attenuator",
                "property": "attenuator.mechanism.jammed",
                "value": true},
     "preconditions": [
