    {"id": "attenuator.motor1.dead", "class": "component",
     "changes": "truth",
     "target": "instrument.attenuator.motor1", "mode": "open_circuit",
     "params": {},
     "persistence": "until_cleared", "reversible": true,
     "action": {"kind": "qom", "path": "/machine/stixctrl/attenuator",
                "property": "attenuator.motor1.dead", "value": true},
