    # The memory upsets (the 2026-11-12 memory-upset plan, M-6a): one
    # qom-set of /machine/stixctrl/edac "upset-inject" per inject, the
    # fixed word riding as the string value. They are one-shot events
    # (the obt.jump precedent): the generic qom action can undo only the
    # property it set, and the poison's clear is the device's own
    # upset-clear verb — the table's "reversible" is the device's, not
    # the platform's. "clear" is dead but required: without it the apply
    # would save the prior with a qom-get, and upset-inject is
    # write-only. A seeded burst across the memories is the device's
    # random-seed/random-count (one action sets one property, so there
    # is no entry for it; see the plan's ground-station recipes).
    {"id": "memory.cache.seu", "class": "memory",
     "changes": "truth",
     "target": "instrument.memory.cache", "mode": "seu", "params": {},
     "persistence": "transient", "reversible": false,
     "action": {"kind": "qom", "path": "/machine/stixctrl/edac",
                "property": "upset-inject",
                "value": "cache,0xE0180040,0x1", "clear": 0},
     "preconditions": [],
     "expected_detection": [
       {"tm": "0x5A7:5:2:542f", "within_s": 1100,
        "note": "corrected on read (cacheCmdSta SECCOUNT++); the periodic SEU report after E_EDAC_SEU_REPORT_PERIOD_S (default 1000 s, Q4)"}]},
