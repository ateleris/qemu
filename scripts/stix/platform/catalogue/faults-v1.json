    {"id": "attenuator.motor2.dead", "class": "component",
     "changes": "truth",
     "target": "instrument.attenuator.motor2", "mode": "open_circuit",
     "params": {},
     "persistence": "until_cleared", "reversible": true,
     "action": {"kind": "qom", "path": "/machine/stixctrl/attenuator",
