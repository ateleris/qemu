    {"id": "attenuator.sensor_bc.stuck_open", "class": "signal",
     "changes": "presented",
     "target": "instrument.attenuator.sensor_bc", "mode": "stuck_at",
     "params": {},
     "persistence": "until_cleared", "reversible": true,
     "action": {"kind": "qom", "path": "/machine/stixctrl/attenuator",
                "property": "attenuator.sensor_bc.stuck_open",
                "value": true},
     "preconditions": [
       "needs a PFM ELF for the FSW to see it"],
     "expected_detection": []},
    {"id": "attenuator.sensor_bc.stuck_closed", "class": "signal",
     "changes": "presented",
     "target": "instrument.attenuator.sensor_bc", "mode": "stuck_at",
     "params": {},
     "persistence": "until_cleared", "reversible": true,
     "action": {"kind": "qom", "path": "/machine/stixctrl/attenuator",
                "property": "attenuator.sensor_bc.stuck_closed",
                "value": true},
     "preconditions": [
       "needs a PFM ELF; one stuck switch is TM-silent, the evidence is SID2 status4 bits 14/13"],
